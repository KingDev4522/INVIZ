# INVIZ backend configuration. Copy to .env and fill in. NEVER commit .env.
# .env is git-ignored AND skipped by scan-secrets (local-only by design);
# provider keys must never appear in any other file.

# Groq API keys, comma-separated (1..N). One vendor serves everything:
# Qwen reasoning, Whisper transcription, AND speech synthesis
# (canopylabs/orpheus-v1-english). More keys = better distribution of rate
# limits, which matters because all three share Groq's quota.
# Get from: GroqCloud console → API Keys. Needs qwen/qwen3.8-27b +
# whisper-large-v3-turbo + canopylabs/orpheus-v1-english access.
#
# ONE-TIME ACCOUNT STEP: the speech model is gated behind a terms acceptance.
# Open the model page in the Groq console and accept once, or /v1/tts answers
# 503 TTS_TERMS until you do.
GROQ_API_KEYS=

# OpenRouter API key (single). Second reasoning vendor: chat + enrichment
# use a LOCAL-FIRST bounded standby chain [ollama -> openrouter -> groq],
# never rotation - a healthy local provider ends the request, so normal turns
# spend no cloud quota. Get from: https://openrouter.ai/keys
# Empty/absent = Groq-only reasoning (transcription + speech always Groq).
OPENROUTER_API_KEY=

# OpenRouter reasoning model. Must be a chat-completions model that returns
# JSON-only outcomes (validated by the shared output contract).
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Tavily API key (single). Powers web search for the agent (/v1/search).
# Get from: https://app.tavily.com/home — every search spends Tavily credits,
# so queries are capped (400 chars) and results truncated server-side.
TAVILY_API_KEY=

# --- Local reasoning provider (Ollama) — ADDITIVE, optional ------------------
# INVIZ talks to your own Ollama over loopback HTTP. No model files are stored
# in this repo and no credentials are involved. Leave OLLAMA_URL empty (or set
# it to "disabled") for cloud-only reasoning; the cloud providers below are
# always kept and act as bounded standbys.
# Request-shape constraints, live-verified on Ollama 0.32.15:
#  - format=<json-schema> returns HTTP 500 on that build, so structured output
#    uses format="json" plus the shared JSON-only system prompt
#  - think=false is always sent: harmless on non-thinking models (Ollama
#    ignores it) and REQUIRED on thinking models such as qwen3.5:9b-q4_K_M,
#    which otherwise spend the whole token budget in a separate `thinking`
#    field and return empty content
OLLAMA_URL=http://127.0.0.1:11434
# The intended local model. MUST match an installed tag EXACTLY (`ollama list`).
OLLAMA_MODEL=qwen3.5:9b-q4_K_M

# Which reasoning provider leads: auto | ollama | groq | openrouter.
# "auto" (default) and "ollama" are BOTH local-first with a bounded cloud
# standby chain:
#   ollama -> openrouter -> groq
# A healthy local response ENDS the request, so normal turns spend no cloud
# reasoning quota. Cloud providers are only contacted after local actually
# fails (unavailable / timeout / model missing / HTTP error / malformed output).
# A local outage is bounded, not permanent: after OLLAMA_SUSPEND_COOLDOWN_MS the
# local provider is re-probed automatically, so starting Ollama later recovers
# without restarting the backend. `POST /v1/validation` clears it immediately.
LLM_PROVIDER=auto

# Keep the local model resident between turns: only the FIRST request then pays
# the cold load. Measured here: cold ~25-60s, warm ~1-3s. Costs ~5.5 GB VRAM
# (16 GB total with the 262k context). Set "0" to unload after every request.
OLLAMA_KEEP_ALIVE=30m
# Bounded budget for one local inference. Must exceed a cold load, otherwise a
# healthy but slow model would be mistaken for a dead one and burn cloud quota.
# Accepted range 10000-900000 ms.
OLLAMA_TIMEOUT_MS=180000

# Port for the backend HTTP service.
PORT=8787

# Optional shared secret: when set, every /v1/* call (except /v1/health)
# must carry `Authorization: Bearer <token>`. The same token is pasted into
# the extension Options page. Leave empty ONLY for loopback development.
BACKEND_TOKEN=